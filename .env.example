# --- Required: Google OAuth client (from GCP Console) ---
# Create at https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID, type: Web application
# Authorized redirect URI: ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Required: this server's public base URL ---
# Used to compute the Google redirect URI registered above and the
# OAuth issuer advertised in /.well-known metadata.
# Local dev: http://localhost:8433
# Production: https://google-mcp.example.com
BASE_URL=http://localhost:8433

# --- Required: HS256 secret for signing MCP JWTs (issued to MCP clients) ---
# Generate with: openssl rand -hex 64
JWT_SECRET=

# --- Required: 32 bytes of randomness, base64url-encoded ---
# Encrypts Google refresh tokens at rest in the SQLite store.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
STORAGE_ENCRYPTION_KEY=

# --- Optional ---
# DATABASE_URL=./google-mcp.db
# MCP_HOST=0.0.0.0
# MCP_PORT=8433
# CORS_ALLOW_LOCALHOST=true  # dev only: any loopback ORIGIN (localhost/127.0.0.1/::1, any scheme/port).
#                             # Production CORS is fixed to https://claude.ai and https://claude.com regardless of this setting.
# ALLOWED_HOSTS=tunnel.example.net,tunnel.example.net:8443  # extra Host/X-Forwarded-Host entries beyond loopback + BASE_URL's host.
#                                                            # Enforced on every route except /health (DNS-rebinding defence);
#                                                            # also extends the RFC 8707 aud/resource allowlist.
# RUST_LOG=google_mcp=info,rmcp=warn,reqwest=warn
# ALLOWED_GOOGLE_ACCOUNTS=user@example.com,@example.com  # exact emails or @domain entries (domain matches Google's `hd`
#                                                         # claim, not the email suffix); unset = any Google account may connect

# --- Optional: filesystem file exchange (local-first deployments) ---
# Absolute path to a directory the file tools may read attachments from and
# write downloads to. docker-compose bind-mounts it into the container at the
# SAME path, so your MCP client and this server name files identically. This
# lets you attach/download files by PATH instead of shovelling base64 through
# the model's context — far cheaper and more reliable.
#   - Attach a local file:   gmail_send attachments=[{ path: "<FILE_ROOT>/report.pdf" }]
#   - Save an attachment:    gmail_download_attachment dest_path="<FILE_ROOT>/in.pdf"
#   - Move Gmail <-> Drive:  attachments=[{ drive_file_id: "..." }] / to_drive_folder_id
# The container runs as uid 65532; make the directory writable by it. Prefer
# handing it ownership or an ACL entry over a world-writable mode:
#   mkdir -p ~/.google-mcp/exchange && sudo chown 65532:65532 ~/.google-mcp/exchange
#   # or, on a directory you already own (e.g. Downloads): setfacl -m u:65532:rwx ~/Downloads
# `chmod 0777 ~/.google-mcp/exchange` also works on a single-user workstation
# but is world-writable — see the README's Operations section for details.
# Leave unset to disable path-based exchange (base64-only fallback).
# FILE_ROOT=/srv/google-mcp/exchange

# --- Optional: file-maintenance tools (files_info / files_cleanup) ---
# Controls whether the directory-maintenance tools are exposed on the MCP
# surface. Off by default, so no listing or DELETION tool exists unless you
# opt in — deletion is never available implicitly. Only meaningful when
# FILE_ROOT is set. Values:
#   off   (default) — neither tool is registered.
#   info            — read-only files_info only (inspect, never delete).
#   full            — files_info + files_cleanup (includes deletion).
# Recommended `off` when FILE_ROOT points at a directory you manage yourself
# (e.g. your Downloads folder).
# FILE_MAINTENANCE_TOOLS=off

# --- Optional: scope which Google Workspace surfaces this server exposes ---
# Comma-separated list (case-insensitive). Unset or empty = all eight.
# Each entry shrinks (a) the MCP tool surface — fewer context tokens
# per agent session — and (b) the OAuth scope set requested from Google
# at consent time, so users only grant the access the operator intends.
# Valid values: gmail, sheets, drive, docs, calendar, tasks, people (alias: contacts),
# searchconsole (aliases: search_console, search-console, webmasters)
# Example (Gmail-only deployment):
# ENABLED_DOMAINS=gmail
